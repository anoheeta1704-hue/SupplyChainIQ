# ============================================
# SupplyChainIQ — Environment Variables Template
# ============================================
# Instructions: Copy this file to .env and configure your values:
#   cp .env.example .env

# ---- Application ----
APP_NAME=SupplyChainIQ
APP_ENV=production
APP_DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- PostgreSQL Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supplychainiq
POSTGRES_USER=sciq_user
POSTGRES_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis Cache ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- JWT Authentication ----
# Generate a secure 64-char hex key: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- Frontend & CORS ----
# In production, replace with your domain (e.g., https://app.yourdomain.com)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Next.js Client Environment Variables (used by frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ---- Streamlit BI ----
STREAMLIT_PORT=8501
API_URL=http://backend:8000/api

# ---- ML Model & Risk Engine ----
MODEL_PATH=./ml/models
DELAY_THRESHOLD_LOW=0.30
DELAY_THRESHOLD_HIGH=0.70

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- AWS S3 Storage (Optional) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
LOCAL_STORAGE_PATH=./storage
