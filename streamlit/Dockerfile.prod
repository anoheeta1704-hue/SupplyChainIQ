FROM python:3.11-slim
WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev curl && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY streamlit/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir psycopg2-binary pydantic-settings structlog redis sqlalchemy asyncpg

# Copy backend config (needed by streamlit for DB config)
COPY backend/app /app/backend/app

# Copy streamlit app
COPY streamlit/app.py /app/app.py
COPY ml/models /app/ml/models

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=10s CMD curl -f http://localhost:8501/_stcore/health || exit 1
ENTRYPOINT ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
